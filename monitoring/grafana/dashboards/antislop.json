{
  "uid": "antislop-overview",
  "title": "AntiSlop Overview",
  "tags": [
    "antislop"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "antislop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Whether Prometheus can scrape the API; separate from database readiness.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"antislop-api\"}",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Metrics database query",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "antislop-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Whether the latest approved-channel count query succeeded.",
      "targets": [
        {
          "refId": "A",
          "expr": "antislop_metrics_database_up{job=\"antislop-api\"}",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Approved channels",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "antislop-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Current database total. No data means unavailable, not zero. Use max rather than summing identical replica counts.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(antislop_approved_channels{job=\"antislop-api\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "API latency \u2014 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antislop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "95th percentile duration by route template. Includes error responses; excludes health checks and scrapes.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(antislop_http_request_duration_seconds_bucket{job=\"antislop-api\",route!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "New reports per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antislop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "Smoothed per-minute rate of successfully created reports. Duplicate retries, invalid requests, and rejected writes are excluded.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(antislop_reports_created_total{job=\"antislop-api\"}[$__rate_interval])) * 60",
          "legendFormat": "New reports"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Blocklist syncs per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antislop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "Includes 200, conditional 304, and error responses.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(antislop_blocklist_sync_requests_total{job=\"antislop-api\"}[$__rate_interval])) * 60",
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Rate-limit rejections per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antislop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "Only HTTP 429 responses. Redis outages are 503 and do not count as rate-limit rejections.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(antislop_rate_limit_rejections_total{job=\"antislop-api\"}[$__rate_interval])) * 60",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": []
}
