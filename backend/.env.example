APP_NAME=AntiSlop API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://antislop:antislop_dev@localhost:5432/antislop
REDIS_URL=redis://localhost:6379/0

# Shared report + appeal buckets: capacity is burst size; refill is seconds/token.
RATE_LIMIT_INSTALL_CAPACITY=5
RATE_LIMIT_INSTALL_REFILL_SECONDS=60
RATE_LIMIT_IP_CAPACITY=20
RATE_LIMIT_IP_REFILL_SECONDS=10
RATE_LIMIT_NAMESPACE=antislop:rate-limit:v1
