{
  "manifest_version": 3,
  "name": "AntiSlop",
  "version": "0.1.0",
  "description": "Filter community-flagged YouTube channels with reversible display controls.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content.css"
      ]
    }
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AntiSlop"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "110",
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
